# Endpoint opsional untuk menerima hasil sesi.
# Opsi A — server lokal (jalankan: node server.js):
# VITE_SUBMIT_URL=http://localhost:3001/submit
#
# Opsi B — Google Apps Script / Firebase:
# VITE_SUBMIT_URL=https://script.google.com/macros/s/xxx/exec
#
# Jika kosong, hasil tetap tersimpan di localStorage dan bisa diunduh sebagai JSON.
VITE_SUBMIT_URL=
